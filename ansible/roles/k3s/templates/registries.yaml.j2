{#
  Renders registry mirrors only. Credentials (configs:/auth:) are intentionally
  omitted; configure Docker Hub authentication manually on each node after the
  role applies this file.
#}
mirrors:
{% for registry, config in k3s_registry_mirrors.items() %}
  "{{ registry }}":
{% if config %}
{{ config | to_nice_yaml(indent=2) | indent(4, true) }}
{% else %}
    {}
{% endif %}
{% endfor %}
