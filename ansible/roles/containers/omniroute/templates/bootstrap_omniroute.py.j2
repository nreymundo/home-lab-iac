class BootstrapError(Exception):
    """Fatal bootstrap failure; messages must never contain credentials."""


class ApiResponse:
    def __init__(self, status, headers, body):
        self.status = status
        self.headers = headers
        self.body = body

    def json(self):
        if not self.body:
            return None
        try:
            return json.loads(self.body.decode("utf-8"))
        except (UnicodeDecodeError, ValueError):
            return None


class OmniRouteClient:
    def __init__(self, base_url, password, access_token=None):
        self.base_url = base_url.rstrip("/")
        self.cookie = None
        self.access_token = access_token
        if not access_token:
            self._login(password)

    def _login(self, password):
        response = self.request("POST", "/api/auth/login", {"password": password})
        if response.status != 200:
            raise BootstrapError(
                "dashboard login failed with HTTP %d; check INITIAL_PASSWORD"
                % response.status
            )
        cookie = response.headers.get("Set-Cookie", "")
        if not cookie:
            raise BootstrapError("dashboard login returned no session cookie")
        self.cookie = cookie.split(";", 1)[0]

    def request(self, method, path, body=None):
        data = json.dumps(body).encode("utf-8") if body is not None else None
        request = urllib.request.Request(self.base_url + path, data=data, method=method)
        request.add_header("Accept", "application/json")
        if body is not None:
            request.add_header("Content-Type", "application/json")
        if self.cookie:
            request.add_header("Cookie", self.cookie)
        if self.access_token:
            request.add_header("Authorization", "Bearer %s" % self.access_token)
        try:
            with urllib.request.urlopen(request, timeout=API_TIMEOUT_SECONDS) as response:
                return ApiResponse(response.status, response.headers, response.read())
        except urllib.error.HTTPError as error:
            return ApiResponse(error.code, error.headers, error.read())

    def _json_request(self, method, path, body=None, statuses=(200,)):
        response = self.request(method, path, body)
        if response.status not in statuses:
            raise BootstrapError("%s %s failed with HTTP %d" % (method, path, response.status))
        return response.json()

    def get(self, path):
        return self._json_request("GET", path)

    def post(self, path, body=None):
        return self._json_request("POST", path, body, (200, 201))

    def patch(self, path, body):
        return self._json_request("PATCH", path, body)

    def put(self, path, body):
        return self._json_request("PUT", path, body)

    def delete(self, path, body=None, allow_missing=False):
        statuses = (200, 404) if allow_missing else (200,)
        return self._json_request("DELETE", path, body, statuses)


def masked_key_matches(masked, desired):
    if not masked or not desired:
        return False
    if "****" not in masked:
        return masked == desired
    prefix, suffix = masked.split("****", 1)
    return desired.startswith(prefix) and desired.endswith(suffix)


def find_unique(items, predicate, label):
    matches = [item for item in items if predicate(item)]
    if len(matches) > 1:
        raise BootstrapError("ambiguous %s: found %d matching objects" % (label, len(matches)))
    return matches[0] if matches else None


def paginated_items(client, path, key):
    items = []
    offset = 0
    while True:
        separator = "&" if "?" in path else "?"
        page = client.get(
            "%s%slimit=%d&offset=%d" % (path, separator, PAGE_SIZE, offset)
        ) or {}
        batch = page.get(key) or []
        items.extend(batch)
        total = page.get("total")
        if total is None or len(items) >= total or len(batch) < PAGE_SIZE:
            return items
        offset += len(batch)


def managed_value_equal(observed, desired):
    if isinstance(desired, dict):
        return isinstance(observed, dict) and all(
            key in observed and managed_value_equal(observed[key], value)
            for key, value in desired.items()
        )
    return observed == desired


def managed_differences(current, desired):
    return sorted(
        key
        for key, value in desired.items()
        if not managed_value_equal(current.get(key), value)
    )


def ensure_general_settings(client, desired, actions):
    if not desired:
        return False
    current = client.get("/api/settings") or {}
    differing = managed_differences(current, desired)
    if not differing:
        actions.append("settings: already converged")
        return False
    client.patch("/api/settings", desired)
    observed = client.get("/api/settings") or {}
    remaining = managed_differences(observed, desired)
    if remaining:
        raise BootstrapError("settings ignored managed fields: %s" % ", ".join(remaining))
    actions.append("settings: updated (%s)" % ", ".join(differing))
    return True


def ensure_oidc_settings(client, desired, actions):
    if not desired.get("enabled"):
        actions.append("oidc: disabled in Ansible configuration; settings untouched")
        return False
    payload = {
        "oidcEnabled": True,
        "oidcIssuer": desired["issuer"],
        "oidcClientId": desired["clientId"],
        "oidcClientSecret": desired["clientSecret"],
        "oidcScopes": desired.get("scopes") or ["openid", "profile", "email"],
        "oidcRedirectPath": desired.get("redirectPath", "/api/auth/oidc/callback"),
        "oidcAllowedSubjects": desired.get("allowedSubjects") or [],
        "oidcDisablePasswordLogin": bool(desired.get("disablePasswordLogin")),
    }
    if not payload["oidcAllowedSubjects"]:
        raise BootstrapError("OIDC requires at least one allowed subject or verified email")
    current = client.get("/api/settings") or {}
    differing = managed_differences(current, payload)
    if not differing:
        actions.append("oidc: settings already converged")
        return False
    payload["currentPassword"] = desired["currentPassword"]
    client.patch("/api/settings", payload)
    actions.append("oidc: updated settings (%s)" % ", ".join(differing))
    return True


def ensure_endpoint_settings(client, path, desired, method, label, actions):
    if not desired:
        return False
    current = client.get(path) or {}
    differing = managed_differences(current, desired)
    if not differing:
        actions.append("%s: already converged" % label)
        return False
    getattr(client, method)(path, desired)
    observed = client.get(path) or {}
    remaining = managed_differences(observed, desired)
    if remaining:
        raise BootstrapError("%s ignored managed fields: %s" % (label, ", ".join(remaining)))
    actions.append("%s: updated (%s)" % (label, ", ".join(differing)))
    return True


def ensure_combo_defaults(client, desired, actions):
    if not desired:
        return False
    current = client.get("/api/settings/combo-defaults") or {}
    body = {
        "comboDefaults": dict(current.get("comboDefaults") or {}),
        "providerOverrides": dict(current.get("providerOverrides") or {}),
    }
    body["comboDefaults"].update(desired.get("comboDefaults") or {})
    for provider, override in (desired.get("providerOverrides") or {}).items():
        merged = dict(body["providerOverrides"].get(provider) or {})
        merged.update(override)
        body["providerOverrides"][provider] = merged
    if current.get("comboDefaults") == body["comboDefaults"] and current.get(
        "providerOverrides"
    ) == body["providerOverrides"]:
        actions.append("combo defaults: already converged")
        return False
    client.patch("/api/settings/combo-defaults", body)
    observed = client.get("/api/settings/combo-defaults") or {}
    if observed.get("comboDefaults") != body["comboDefaults"] or observed.get(
        "providerOverrides"
    ) != body["providerOverrides"]:
        raise BootstrapError("combo defaults did not survive API readback")
    actions.append("combo defaults: updated")
    return True


def provider_connections(client):
    return (client.get("/api/providers") or {}).get("connections") or []


def ensure_provider_connection(client, spec, actions):
    provider = spec["providerId"]
    name = spec["name"]
    existing = find_unique(
        provider_connections(client),
        lambda item: item.get("provider") == provider and item.get("name") == name,
        "provider connection %s/%s" % (provider, name),
    )
    api_key = spec.get("apiKey") or ""
    desired_specific = spec.get("providerSpecificData") or {}
    if not existing:
        if not api_key:
            actions.append("provider %s/%s: unavailable (enrollment or API key required)" % (provider, name))
            return None, False
        body = {"provider": provider, "name": name, "apiKey": api_key}
        if desired_specific:
            body["providerSpecificData"] = desired_specific
        created = client.post("/api/providers", body) or {}
        connection = created.get("connection") or created
        actions.append("provider %s/%s: created" % (provider, name))
        return connection.get("id"), True

    changed_fields = []
    body = {"name": name}
    if api_key and not masked_key_matches(existing.get("apiKey"), api_key):
        body["apiKey"] = api_key
        changed_fields.append("credential")
    current_specific = dict(existing.get("providerSpecificData") or {})
    merged_specific = dict(current_specific)
    merged_specific.update(desired_specific)
    if any(current_specific.get(key) != value for key, value in desired_specific.items()):
        body["providerSpecificData"] = merged_specific
        changed_fields.append("providerSpecificData")
    if changed_fields:
        client.put("/api/providers/%s" % existing["id"], body)
        actions.append("provider %s/%s: updated (%s)" % (provider, name, ", ".join(changed_fields)))
        return existing.get("id"), True
    actions.append("provider %s/%s: already converged" % (provider, name))
    return existing.get("id"), False


def require_provider_connection(client, spec, actions, warnings):
    matches = [
        item
        for item in provider_connections(client)
        if item.get("provider") == spec["providerId"]
        and (not spec.get("name") or item.get("name") == spec["name"])
    ]
    if len(matches) > 1:
        raise BootstrapError("ambiguous required provider %s" % spec["providerId"])
    if not matches:
        message = "provider %s requires native enrollment before inference acceptance" % spec["providerId"]
        warnings.append(message)
        actions.append(message)
        return None
    actions.append("provider %s: enrollment present" % spec["providerId"])
    return matches[0].get("id")


def ensure_provider_node(client, spec, actions):
    nodes = (client.get("/api/provider-nodes") or {}).get("nodes") or []
    existing = find_unique(nodes, lambda item: item.get("name") == spec["name"], "provider node %s" % spec["name"])
    desired = {
        "name": spec["name"],
        "prefix": spec["prefix"],
        "apiType": spec["apiType"],
        "baseUrl": spec["baseUrl"],
    }
    if existing:
        differing = managed_differences(existing, desired)
        if differing:
            client.put("/api/provider-nodes/%s" % existing["id"], desired)
            actions.append("node %s: updated (%s)" % (spec["name"], ", ".join(differing)))
            return existing.get("id"), True
        actions.append("node %s: already converged" % spec["name"])
        return existing.get("id"), False
    body = dict(desired)
    body["type"] = spec.get("type", "openai-compatible")
    created = client.post("/api/provider-nodes", body) or {}
    node = created.get("node") or created
    actions.append("node %s: created" % spec["name"])
    return node.get("id"), True


def ensure_node_connection(client, node_id, spec, actions):
    connections = provider_connections(client)
    existing = find_unique(
        connections,
        lambda item: item.get("provider") == node_id,
        "provider-node connection %s" % spec["connectionName"],
    )
    api_key = spec.get("apiKey") or ""
    if existing:
        body = {"name": spec["connectionName"]}
        differing = []
        if existing.get("name") != spec["connectionName"]:
            differing.append("name")
        if api_key and not masked_key_matches(existing.get("apiKey"), api_key):
            body["apiKey"] = api_key
            differing.append("credential")
        if differing:
            client.put("/api/providers/%s" % existing["id"], body)
            actions.append("node connection: updated (%s)" % ", ".join(differing))
            return existing.get("id"), True
        actions.append("node connection: already converged")
        return existing.get("id"), False
    if not api_key:
        actions.append("node connection: skipped (no API key configured)")
        return None, False
    created = client.post(
        "/api/providers",
        {"provider": node_id, "name": spec["connectionName"], "apiKey": api_key},
    ) or {}
    connection = created.get("connection") or created
    actions.append("node connection: created")
    return connection.get("id"), True


def count_changes(value):
    if isinstance(value, int):
        return value
    if isinstance(value, list):
        return len(value)
    return 0


def sync_models(client, connection_id, label, actions):
    path = "/api/providers/%s/sync-models?mode=import" % urllib.parse.quote(str(connection_id), safe="")
    result = client.post(path) or {}
    changes = result.get("modelChanges") or {}
    changed = any(count_changes(changes.get(key)) > 0 for key in ("added", "removed", "updated"))
    actions.append(
        "model sync %s: %s available (%s added, %s removed, %s updated)"
        % (
            label,
            result.get("availableModelsCount", "?"),
            count_changes(changes.get("added")),
            count_changes(changes.get("removed")),
            count_changes(changes.get("updated")),
        )
    )
    return changed


def canonical_combo_step(item, desired_item=None):
    if isinstance(item, str):
        provider, separator, _ = item.partition("/")
        return {"provider": provider, "model": item} if separator else {"model": item}
    if not isinstance(item, dict):
        return item
    if item.get("kind") == "combo-ref":
        result = {"kind": "combo-ref", "comboName": item.get("comboName")}
    else:
        provider = item.get("provider", item.get("providerId"))
        model = item.get("model")
        if provider and model and not model.startswith("%s/" % provider):
            model = "%s/%s" % (provider, model)
        result = {"provider": provider, "model": model}
        result = {key: value for key, value in result.items() if value is not None}
    desired_dict = desired_item if isinstance(desired_item, dict) else {}
    for field in (
        "connectionId",
        "allowedConnectionIds",
        "tags",
        "prompt",
        "weight",
        "label",
        "fallbackOnlyOnQuotaExhaustion",
    ):
        if field in desired_dict:
            result[field] = item.get(field)
    return result


def combo_models_equal(observed, desired):
    if len(observed or []) != len(desired or []):
        return False
    return all(
        canonical_combo_step(current, wanted) == canonical_combo_step(wanted, wanted)
        for current, wanted in zip(observed or [], desired or [])
    )


def combo_list(client):
    return paginated_items(client, "/api/combos", "combos")


def ensure_combo(client, spec, actions):
    name = spec["name"]
    existing = find_unique(combo_list(client), lambda item: item.get("name") == name, "combo %s" % name)
    create_body = {"name": name, "models": spec["models"]}
    for field in COMBO_FIELDS:
        if field in spec:
            create_body[field] = spec[field]
    if existing:
        differing = []
        if not combo_models_equal(existing.get("models") or [], spec["models"]):
            differing.append("models")
        for field in COMBO_FIELDS + COMBO_UPDATE_ONLY_FIELDS:
            if field in spec and not managed_value_equal(existing.get(field), spec[field]):
                differing.append(field)
        if differing:
            update_body = dict(create_body)
            for field in COMBO_UPDATE_ONLY_FIELDS:
                if field in spec:
                    update_body[field] = spec[field]
            client.put("/api/combos/%s" % existing["id"], update_body)
            actions.append("combo '%s': updated (%s)" % (name, ", ".join(differing)))
            return existing.get("id"), True
        actions.append("combo '%s': already converged" % name)
        return existing.get("id"), False
    created = client.post("/api/combos", create_body) or {}
    combo = created.get("combo") or created
    combo_id = combo.get("id")
    actions.append("combo '%s': created" % name)
    state = {field: spec[field] for field in COMBO_UPDATE_ONLY_FIELDS if field in spec}
    if state:
        update_body = dict(create_body)
        update_body.update(state)
        client.put("/api/combos/%s" % combo_id, update_body)
        actions.append("combo '%s': applied active/visibility state" % name)
    return combo_id, True


def ensure_mapping(client, spec, combo_ids, actions):
    combo_id = combo_ids.get(spec["comboName"])
    if not combo_id:
        raise BootstrapError("mapping '%s' references unavailable combo" % spec["pattern"])
    mappings = (client.get("/api/model-combo-mappings") or {}).get("mappings") or []
    existing = find_unique(
        mappings,
        lambda item: item.get("pattern") == spec["pattern"],
        "mapping %s" % spec["pattern"],
    )
    body = {"pattern": spec["pattern"], "comboId": combo_id}
    for field in ("priority", "enabled", "description"):
        if field in spec:
            body[field] = spec[field]
    if existing:
        differing = managed_differences(existing, body)
        if differing:
            client.put("/api/model-combo-mappings/%s" % existing["id"], body)
            actions.append("mapping '%s': updated" % spec["pattern"])
            return True
        actions.append("mapping '%s': already converged" % spec["pattern"])
        return False
    client.post("/api/model-combo-mappings", body)
    actions.append("mapping '%s': created" % spec["pattern"])
    return True


def ensure_model_aliases(client, aliases, actions):
    current = (client.get("/api/settings/model-aliases") or {}).get("custom") or {}
    changed = False
    for alias, target in (aliases or {}).items():
        if current.get(alias) == target:
            actions.append("model alias '%s': already converged" % alias)
            continue
        client.post("/api/settings/model-aliases", {"from": alias, "to": target})
        actions.append("model alias '%s': %s" % (alias, "updated" if alias in current else "created"))
        changed = True
    return changed


def model_field_value(model, field):
    aliases = {
        "max_input_tokens": ("max_input_tokens", "inputTokenLimit", "maxInputTokens"),
        "max_output_tokens": ("max_output_tokens", "outputTokenLimit", "maxOutputTokens"),
    }
    for key in aliases.get(field, (field,)):
        if key in model:
            return model.get(key)
    return None


def provider_model_state(client, provider):
    path = "/api/provider-models?provider=%s" % urllib.parse.quote(provider, safe="")
    return client.get(path) or {}


def provider_models(client, provider):
    return provider_model_state(client, provider).get("models") or []


def matching_model_record(records, model_id, label):
    return find_unique(
        records or [],
        lambda item: item.get("id", item.get("modelId")) == model_id,
        label,
    )


def preserved_model_create_body(provider, model_id, existing):
    body = {"provider": provider, "modelId": model_id}
    field_map = {
        "name": "modelName",
        "source": "source",
        "apiFormat": "apiFormat",
        "supportedEndpoints": "supportedEndpoints",
        "targetFormat": "targetFormat",
        "inputTokenLimit": "max_input_tokens",
        "outputTokenLimit": "max_output_tokens",
        "supportsVision": "supportsVision",
        "generationConfig": "generationConfig",
        "isFree": "isFree",
        "dimensions": "dimensions",
        "supportedInputTypes": "supportedInputTypes",
        "modelType": "modelType",
    }
    ignored = {
        "id",
        "contextWindowOverride",
        "contextWindowOverrideSource",
    }
    unsupported = sorted(set(existing) - set(field_map) - ignored)
    if unsupported:
        raise BootstrapError(
            "provider model %s/%s has metadata that cannot be safely recreated: %s"
            % (provider, model_id, ", ".join(unsupported))
        )
    for current_field, api_field in field_map.items():
        if current_field in existing:
            body[api_field] = existing[current_field]
    return body


def expected_model_row(create_body):
    field_map = {
        "modelName": "name",
        "source": "source",
        "apiFormat": "apiFormat",
        "supportedEndpoints": "supportedEndpoints",
        "targetFormat": "targetFormat",
        "max_input_tokens": "inputTokenLimit",
        "max_output_tokens": "outputTokenLimit",
        "supportsVision": "supportsVision",
        "generationConfig": "generationConfig",
        "isFree": "isFree",
        "dimensions": "dimensions",
        "supportedInputTypes": "supportedInputTypes",
        "modelType": "modelType",
    }
    expected = {"id": create_body["modelId"]}
    for api_field, stored_field in field_map.items():
        if api_field in create_body:
            expected[stored_field] = create_body[api_field]
    return expected


def validate_model_compatibility(provider, model_id, compat):
    unsupported = sorted(
        set(compat or {})
        - {
            "id",
            "normalizeToolCallId",
            "preserveOpenAIDeveloperRole",
            "compatByProtocol",
            "upstreamHeaders",
            "isHidden",
            "hiddenModalities",
            "apiFormat",
            "targetFormat",
            "supportsVision",
        }
    )
    if "preserveVideoUrl" in (compat or {}):
        unsupported.append("preserveVideoUrl")
    if unsupported:
        raise BootstrapError(
            "provider model %s/%s has compatibility metadata that cannot be safely restored: %s"
            % (provider, model_id, ", ".join(sorted(set(unsupported))))
        )


def restore_model_compatibility(client, provider, model_id, compat, actions):
    if not compat:
        return
    validate_model_compatibility(provider, model_id, compat)
    update_fields = (
        "normalizeToolCallId",
        "preserveOpenAIDeveloperRole",
        "compatByProtocol",
        "upstreamHeaders",
        "apiFormat",
        "targetFormat",
        "supportsVision",
    )
    update_body = {"provider": provider, "modelId": model_id}
    update_body.update({field: compat[field] for field in update_fields if field in compat})
    if len(update_body) > 2:
        client.put("/api/provider-models", update_body)
    if "isHidden" in compat:
        path = "/api/provider-models?provider=%s&modelId=%s" % (
            urllib.parse.quote(provider, safe=""),
            urllib.parse.quote(model_id, safe=""),
        )
        client.patch(path, {"isHidden": bool(compat["isHidden"])})
    for modality, hidden in (compat.get("hiddenModalities") or {}).items():
        path = "/api/provider-models?provider=%s&modelId=%s" % (
            urllib.parse.quote(provider, safe=""),
            urllib.parse.quote(model_id, safe=""),
        )
        client.patch(path, {"isHidden": bool(hidden), "modality": modality})
    actions.append("provider model %s/%s: restored compatibility metadata" % (provider, model_id))


def ensure_provider_model(client, spec, provider_ids, actions):
    provider = provider_ids.get(spec["providerRef"], spec["providerRef"])
    model_id = spec["modelId"]
    state = provider_model_state(client, provider)
    models = state.get("models") or []
    existing = find_unique(
        models,
        lambda item: item.get("id") == model_id,
        "provider model %s/%s" % (provider, model_id),
    )
    body = {"provider": provider, "modelId": model_id}
    for field in MODEL_MUTABLE_FIELDS + MODEL_CREATE_ONLY_FIELDS:
        if field in spec:
            body[field] = spec[field]
    if not existing:
        client.post("/api/provider-models", body)
        observed = find_unique(
            provider_models(client, provider),
            lambda item: item.get("id") == model_id,
            "created provider model %s/%s" % (provider, model_id),
        )
        if not observed:
            raise BootstrapError("provider model %s/%s was not readable after creation" % (provider, model_id))
        actions.append("provider model %s/%s: created" % (provider, model_id))
        return True

    mutable_diff = [
        field
        for field in MODEL_MUTABLE_FIELDS
        if field in spec and model_field_value(existing, field) != spec[field]
    ]
    create_only_diff = [
        field
        for field in MODEL_CREATE_ONLY_FIELDS
        if field in spec and model_field_value(existing, field) != spec[field]
    ]
    changed = False
    if create_only_diff:
        if not spec.get("recreateForCreateOnlyChanges"):
            raise BootstrapError(
                "provider model %s/%s has unsupported create-only drift: %s"
                % (provider, model_id, ", ".join(create_only_diff))
            )
        compat = matching_model_record(
            state.get("modelCompatOverrides") or [],
            model_id,
            "compatibility metadata %s/%s" % (provider, model_id),
        )
        context = matching_model_record(
            state.get("modelContextOverrides") or [],
            model_id,
            "context metadata %s/%s" % (provider, model_id),
        )
        recreate_body = preserved_model_create_body(provider, model_id, existing)
        validate_model_compatibility(provider, model_id, compat)
        if context and context.get("contextWindowOverrideSource") != "manual":
            raise BootstrapError(
                "provider model %s/%s has a context override that cannot be safely restored"
                % (provider, model_id)
            )
        recreate_body.update(body)
        path = "/api/provider-models?provider=%s&model=%s&resetOverride=true" % (
            urllib.parse.quote(provider, safe=""),
            urllib.parse.quote(model_id, safe=""),
        )
        client.delete(path)
        client.post("/api/provider-models", recreate_body)
        restore_model_compatibility(client, provider, model_id, compat, actions)
        if context:
            client.put(
                "/api/provider-models",
                {
                    "provider": provider,
                    "modelId": model_id,
                    "contextWindowOverride": context["contextWindowOverride"],
                },
            )
            actions.append("provider model %s/%s: restored context override" % (provider, model_id))
        actions.append("provider model %s/%s: recreated for create-only metadata" % (provider, model_id))
        changed = True
    elif mutable_diff:
        update_body = {"provider": provider, "modelId": model_id}
        update_body.update({field: spec[field] for field in mutable_diff})
        client.put("/api/provider-models", update_body)
        actions.append("provider model %s/%s: updated (%s)" % (provider, model_id, ", ".join(mutable_diff)))
        changed = True
    else:
        actions.append("provider model %s/%s: already converged" % (provider, model_id))
        return False

    observed_state = provider_model_state(client, provider)
    observed = find_unique(
        observed_state.get("models") or [],
        lambda item: item.get("id") == model_id,
        "provider model readback %s/%s" % (provider, model_id),
    )
    if not observed:
        raise BootstrapError("provider model %s/%s disappeared during reconciliation" % (provider, model_id))
    if create_only_diff:
        observed_compat = matching_model_record(
            observed_state.get("modelCompatOverrides") or [],
            model_id,
            "compatibility metadata readback %s/%s" % (provider, model_id),
        )
        if compat and observed_compat != compat:
            raise BootstrapError(
                "provider model %s/%s compatibility metadata changed during recreation"
                % (provider, model_id)
            )
        observed_context = matching_model_record(
            observed_state.get("modelContextOverrides") or [],
            model_id,
            "context metadata readback %s/%s" % (provider, model_id),
        )
        if context and (
            not observed_context
            or observed_context.get("contextWindowOverride")
            != context.get("contextWindowOverride")
        ):
            raise BootstrapError(
                "provider model %s/%s context metadata changed during recreation"
                % (provider, model_id)
            )
        preserved_drift = managed_differences(
            observed,
            expected_model_row(recreate_body),
        )
        if preserved_drift:
            raise BootstrapError(
                "provider model %s/%s lost metadata during recreation: %s"
                % (provider, model_id, ", ".join(preserved_drift))
            )
    remaining = [
        field
        for field in MODEL_MUTABLE_FIELDS + MODEL_CREATE_ONLY_FIELDS
        if field in spec and model_field_value(observed, field) != spec[field]
    ]
    if remaining:
        raise BootstrapError("provider model %s/%s ignored fields: %s" % (provider, model_id, ", ".join(remaining)))
    return changed


def read_stored_keys(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return []
    return data if isinstance(data, list) else []


def load_stored_key(path, name):
    for entry in read_stored_keys(path):
        if entry.get("name") == name and entry.get("key"):
            return entry["key"]
    return None


def store_created_key(path, entry):
    existing = read_stored_keys(path)
    replaced = False
    for index, current in enumerate(existing):
        if current.get("name") == entry["name"]:
            existing[index] = entry
            replaced = True
            break
    if not replaced:
        existing.append(entry)
    temporary = "%s.tmp" % path
    with open(temporary, "w", encoding="utf-8") as handle:
        json.dump(existing, handle, indent=2)
        handle.write("\n")
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)
    os.chmod(path, 0o600)


def remove_stored_keys(path, names):
    existing = read_stored_keys(path)
    retained = [entry for entry in existing if entry.get("name") not in names]
    if retained == existing:
        return
    temporary = "%s.tmp" % path
    with open(temporary, "w", encoding="utf-8") as handle:
        json.dump(retained, handle, indent=2)
        handle.write("\n")
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)
    os.chmod(path, 0o600)


def key_list(client):
    return paginated_items(client, "/api/keys", "keys")


def ensure_api_key(client, spec, output_path, actions):
    name = spec["name"]
    existing = find_unique(key_list(client), lambda item: item.get("name") == name, "API key %s" % name)
    created = False
    if not existing:
        create_body = {"name": name}
        for field in CREATE_KEY_FIELDS:
            if field in spec:
                create_body[field] = spec[field]
        response = client.post("/api/keys", create_body) or {}
        if not response.get("key") or not response.get("id"):
            raise BootstrapError("API key '%s' creation returned no recoverable key" % name)
        store_created_key(
            output_path,
            {"name": name, "id": response["id"], "key": response["key"]},
        )
        existing = {"id": response["id"], "name": name}
        created = True
        actions.append("api key '%s': created and raw value stored" % name)

    detail = client.get("/api/keys/%s" % existing["id"]) or existing
    desired = {field: spec[field] for field in UPDATE_KEY_FIELDS if field in spec}
    differing = managed_differences(detail, desired)
    if differing:
        payload = {field: desired[field] for field in differing}
        client.patch("/api/keys/%s" % existing["id"], payload)
        observed = client.get("/api/keys/%s" % existing["id"]) or {}
        remaining = managed_differences(observed, desired)
        if remaining:
            raise BootstrapError("API key '%s' ignored managed fields: %s" % (name, ", ".join(remaining)))
        actions.append("api key '%s': updated permissions (%s)" % (name, ", ".join(differing)))
        return True
    if not created:
        actions.append("api key '%s': already converged" % name)
    return created


def remove_api_keys(client, names, management_name, output_path, actions):
    names = set(names or [])
    if management_name in names:
        raise BootstrapError("management API key cannot be scheduled for removal")
    changed = False
    for existing in key_list(client):
        if existing.get("name") in names:
            client.delete("/api/keys/%s" % existing["id"])
            actions.append("api key '%s': removed" % existing["name"])
            changed = True
    remove_stored_keys(output_path, names)
    return changed


def reconcile(config, client, actions, warnings):
    changed = False
    output_path = config["apiKeysOutputFile"]
    management_name = config["managementKeyName"]
    management_token = load_stored_key(output_path, management_name)

    oidc_desired = dict(config.get("oidc") or {})
    oidc_initial = dict(oidc_desired)
    if oidc_desired.get("disablePasswordLogin") and not management_token:
        oidc_initial["disablePasswordLogin"] = False
    changed = ensure_oidc_settings(client, oidc_initial, actions) or changed
    changed = ensure_general_settings(client, config.get("settings") or {}, actions) or changed
    changed = ensure_endpoint_settings(
        client,
        "/api/settings/cache-config",
        config.get("cacheSettings") or {},
        "put",
        "cache settings",
        actions,
    ) or changed
    changed = ensure_endpoint_settings(
        client,
        "/api/settings/compression",
        config.get("compressionSettings") or {},
        "put",
        "compression settings",
        actions,
    ) or changed
    changed = ensure_combo_defaults(client, config.get("comboDefaults") or {}, actions) or changed

    provider_ids = {}
    for spec in config.get("providers") or []:
        if not spec.get("enabled", True):
            actions.append("provider %s/%s: skipped" % (spec["providerId"], spec["name"]))
            continue
        connection_id, provider_changed = ensure_provider_connection(client, spec, actions)
        changed = provider_changed or changed
        if connection_id:
            provider_ids[spec.get("ref", spec["providerId"])] = spec["providerId"]
            if spec.get("syncModels"):
                changed = sync_models(client, connection_id, spec["name"], actions) or changed

    for spec in config.get("requiredProviders") or []:
        connection_id = require_provider_connection(client, spec, actions, warnings)
        if connection_id and spec.get("syncModels"):
            changed = sync_models(client, connection_id, spec.get("name") or spec["providerId"], actions) or changed

    node_spec = config.get("providerNode") or {}
    if node_spec.get("enabled"):
        node_id, node_changed = ensure_provider_node(client, node_spec, actions)
        changed = node_changed or changed
        if node_id:
            provider_ids[node_spec.get("ref", "providerNode")] = node_id
            connection_id, connection_changed = ensure_node_connection(client, node_id, node_spec, actions)
            changed = connection_changed or changed
            if connection_id and node_spec.get("syncModels", True):
                changed = sync_models(client, connection_id, node_spec["name"], actions) or changed
    else:
        message = "provider node: unavailable; llama-swap routes are not ready"
        actions.append(message)
        warnings.append(message)

    for spec in config.get("providerModels") or []:
        if spec["providerRef"] not in provider_ids and spec["providerRef"] == "providerNode":
            warnings.append("provider-node metadata skipped because llama-swap is unavailable")
            continue
        changed = ensure_provider_model(client, spec, provider_ids, actions) or changed

    combo_ids = {}
    for spec in config.get("combos") or []:
        combo_id, combo_changed = ensure_combo(client, spec, actions)
        changed = combo_changed or changed
        if combo_id:
            combo_ids[spec["name"]] = combo_id
    for spec in config.get("modelComboMappings") or []:
        changed = ensure_mapping(client, spec, combo_ids, actions) or changed

    changed = ensure_model_aliases(client, config.get("modelAliases") or {}, actions) or changed

    for spec in config.get("apiKeys") or []:
        changed = ensure_api_key(client, spec, output_path, actions) or changed

    if not load_stored_key(output_path, management_name):
        raise BootstrapError("management API key '%s' is unavailable; password login remains enabled" % management_name)
    changed = remove_api_keys(
        client,
        config.get("apiKeysToRemove") or [],
        management_name,
        output_path,
        actions,
    ) or changed

    if oidc_initial.get("disablePasswordLogin") != oidc_desired.get("disablePasswordLogin"):
        changed = ensure_oidc_settings(client, oidc_desired, actions) or changed
    return changed


def main():
    if len(sys.argv) != 2:
        raise BootstrapError("usage: bootstrap_omniroute.py <config.json>")
    with open(sys.argv[1], "r", encoding="utf-8") as handle:
        config = json.load(handle)
    actions = []
    warnings = []
    output_path = config["apiKeysOutputFile"]
    token = load_stored_key(output_path, config["managementKeyName"])
    client = OmniRouteClient(config["dashboardUrl"], config["initialPassword"], token)
    try:
        changed = reconcile(config, client, actions, warnings)
    except BootstrapError as error:
        print(
            json.dumps(
                {
                    "ok": False,
                    "changed": bool(actions),
                    "actions": actions,
                    "warnings": warnings,
                    "error": str(error),
                }
            )
        )
        return 1
    print(json.dumps({"ok": True, "changed": changed, "actions": actions, "warnings": warnings}))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BootstrapError as error:
        print(json.dumps({"ok": False, "changed": False, "actions": [], "warnings": [], "error": str(error)}))
        sys.exit(1)
