#!/usr/bin/env python3
"""Reconcile OmniRoute management state from Ansible-rendered JSON.

The script uses only OmniRoute's supported management APIs. It preserves
unmanaged objects and native OAuth state, prints one secret-free JSON result,
and stores one-time API key values in the root-owned output file before any
later API request is attempted.
"""

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

API_TIMEOUT_SECONDS = 60
PAGE_SIZE = 200

