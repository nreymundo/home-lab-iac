PORT={{ omniroute_container_port }}
DATA_DIR=/app/data
INITIAL_PASSWORD={{ omniroute_secrets.omniroute_initial_password }}
JWT_SECRET={{ omniroute_secrets.omniroute_jwt_secret }}
API_KEY_SECRET={{ omniroute_secrets.omniroute_api_key_secret }}
STORAGE_ENCRYPTION_KEY={{ omniroute_secrets.omniroute_storage_encryption_key }}
OMNIROUTE_WS_BRIDGE_SECRET={{ omniroute_secrets.omniroute_ws_bridge_secret }}
AUTH_COOKIE_SECURE=true
REQUIRE_API_KEY=true
OMNIROUTE_MEMORY_MB={{ omniroute_memory_mb }}
FETCH_TIMEOUT_MS={{ omniroute_fetch_timeout_ms }}
PRICING_SYNC_ENABLED={{ omniroute_pricing_sync_enabled | bool | lower }}
AUDIO_REMOTE_PROVIDER_NODES={{ omniroute_audio_remote_provider_nodes | bool | lower }}
RERANK_REMOTE_PROVIDER_NODES={{ omniroute_rerank_remote_provider_nodes | bool | lower }}
REDIS_URL=redis://redis:6379
