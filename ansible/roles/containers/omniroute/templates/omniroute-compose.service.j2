[Unit]
Description=OmniRoute Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory={{ omniroute_config_dir }}
ExecStart=/usr/bin/docker compose --env-file {{ omniroute_env_file }} -p {{ omniroute_compose_project_name }} -f {{ omniroute_compose_file }} up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file {{ omniroute_env_file }} -p {{ omniroute_compose_project_name }} -f {{ omniroute_compose_file }} down

[Install]
WantedBy=multi-user.target
