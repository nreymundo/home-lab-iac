locals {
  nodes_by_name = {
    for node in local.k3s.nodes : "k3s-node-${format("%02d", node.node_number)}" => node
  }
}

resource "local_file" "ansible_inventory" {
  filename = abspath("${path.module}/../../../../ansible/inventories/k3s-nodes.yml")

  lifecycle {
    precondition {
      condition     = length(local.k3s.nodes) > 0
      error_message = "At least one node must be defined in local.k3s.nodes."
    }

    precondition {
      condition     = local.k3s.ip_prefix_len >= 8 && local.k3s.ip_prefix_len <= 30
      error_message = "local.k3s.ip_prefix_len must be between /8 and /30."
    }

    precondition {
      condition     = length(local.k3s.proxmox_nodes) > 0
      error_message = "At least one Proxmox node must be defined in local.k3s.proxmox_nodes."
    }

  }

  content = join("", [
    "---\n",
    "# THIS FILE IS DYNAMICALLY GENERATED BY TERRAFORM.\n",
    "# DO NOT EDIT MANUALLY - YOUR CHANGES WILL BE OVERWRITTEN.\n\n",
    yamlencode({
      all = {
        children = {
          k3s_nodes = {
            hosts = {
              for name, instance in module.proxmox_vms : name => {
                ansible_host = instance.vms[0].ip_address
                ansible_user = instance.vms[0].ansible_user
                ansible_port = 22
                node_os      = instance.vms[0].ci_user
                k3s_node_labels = merge(
                  {
                    "homelab.lan/role"            = "general"
                    "homelab.lan/cpu-vendor"      = "intel"
                    "homelab.lan/runtime"         = "vm"
                    "homelab.lan/hypervisor"      = "proxmox"
                    "homelab.lan/gpu"             = length(try(local.nodes_by_name[name].pci_devices, [])) > 0 ? "intel" : "none"
                    "topology.kubernetes.io/zone" = instance.vms[0].target_node
                  },
                  try(local.nodes_by_name[name].labels, {})
                )
              }
            }
          }
        }
      }
    })
  ])
}
