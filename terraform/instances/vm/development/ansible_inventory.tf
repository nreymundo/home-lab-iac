resource "local_file" "ansible_inventory" {
  filename = abspath("${path.module}/../../../../ansible/inventories/development.yml")

  content = join("", [
    "---\n",
    "# THIS FILE IS DYNAMICALLY GENERATED BY TERRAFORM.\n",
    "# DO NOT EDIT MANUALLY - YOUR CHANGES WILL BE OVERWRITTEN.\n\n",
    yamlencode({
      all = {
        children = {
          development_vms = {
            hosts = {
              for vm in module.unraid_vms.vms : vm.hostname => {
                ansible_host = vm.ip_address
                ansible_user = vm.ansible_user
                ansible_port = 22
                node_os      = vm.ansible_user
              }
            }
          }
        }
      }
    })
  ])
}
