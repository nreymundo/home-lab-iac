resource "local_file" "ansible_inventory" {
  filename = abspath("${path.module}/../../../../ansible/inventories/development.yml")

  content = join("", [
    "---\n",
    "# THIS FILE IS DYNAMICALLY GENERATED BY TERRAFORM.\n",
    "# DO NOT EDIT MANUALLY - YOUR CHANGES WILL BE OVERWRITTEN.\n\n",
    yamlencode({
      all = {
        children = {
          development_vms = {
            hosts = {
              (local.vm_definition.hostname) = {
                ansible_host = local.vm_definition.ip_address
                ansible_user = local.vm_definition.ansible_user
                ansible_port = 22
                node_os      = local.vm_definition.ansible_user
              }
            }
          }
        }
      }
    })
  ])
}
